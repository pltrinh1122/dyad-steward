{
  "permissions": {
    "allow": [
      "Bash(git push origin:*)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d*)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(git push * :*)"
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Git Push to Default Branch: dyad-steward is a solo-operator substrate where direct push to main is the intended durability workflow (PRs are reserved for the Commons, not this repo)"
    ]
  }
}

